<h1>Editar produto</h1>

<form action="/produtos/<%= produto.id %>" method="POST">

    <label>Nome:</label>
    <input
        type="text"
        name="nome"
        value="<%= produto.nome %>"
        required
    >

    <br>

    <label>Preço:</label>
    <input
        type="number"
        name="preco"
        step="0.01"
        value="<%= produto.preco %>"
        required
    >

    <br>

    <label>Quantidade:</label>
    <input
        type="number"
        name="quantidade"
        value="<%= produto.quantidade %>"
    >

    <br>

    <label>Categoria:</label>
    <% if (categorias.length === 0) { %>
        <p><strong>Nenhuma categoria cadastrada.</strong> Cadastre uma categoria antes de editar produtos.</p>
        <a href="/categorias/novo">+ Nova categoria</a>

        <br><br>

        <button type="submit" disabled>
            Atualizar
        </button>
    <% } else { %>
        <select name="categoriaId" required>
            <% categorias.forEach(c => { %>
                <option
                    value="<%= c.id %>"
                    <% if (c.id === produto.categoriaId) { %>selected<% } %>
                >
                    <%= c.nome %>
                </option>
            <% }) %>
        </select>
        <a href="/categorias/novo">+ Nova categoria</a>

        <br>

        <button type="submit">
            Atualizar
        </button>
    <% } %>

</form>
